{
  "name": "tanuki",
  "description": "Personal digital asset management system.",
  "private": true,
  "version": "1.0.0",
  "author": "Nathan Fiedler",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nlfiedler/tanuki.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/nlfiedler/tanuki",
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "prestart": "bun run codegen && bun run fetch-models",
    "pretest": "bun run fetch-models",
    "prebuild": "bun run fetch-models",
    "start": "bun server/main.ts",
    "doc": "bunx jsdoc --recurse server",
    "codegen": "graphql-codegen --config codegen.ts",
    "fetch-models": "bun run scripts/fetch-models.ts",
    "build-release-assets": "bun run scripts/build-release-assets.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.8",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@solid-primitives/graphql": "^2.2.6",
    "@solidjs/router": "^0.16.3",
    "awilix": "^13.0.5",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "exifreader": "^4.41.3",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^1.25.0",
    "helmet": "^8.3.0",
    "mime": "^4.1.0",
    "morgan": "^1.11.0",
    "mp4box": "^2.4.1",
    "multer": "^2.2.0",
    "nano": "^11.0.6",
    "onnxruntime-node": "^1.27.0",
    "pouchdb": "^9.0.0",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.14",
    "ulid": "^3.0.2",
    "vite-express": "^0.22.1",
    "whatwg-mimetype": "^5.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@aryzing/bun-mock-fetch": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-resolvers": "^5.1.8",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/pouchdb": "^6.4.2",
    "@types/whatwg-mimetype": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.8.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "tempy": "^3.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "trustedDependencies": [
    "onnxruntime-node"
  ]
}
